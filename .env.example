# Copy to **fastlane/.env** (recommended for `fastlane distribute`) or export in your shell before running fastlane.
# Ruby fastlane reads env vars from the process environment; many teams use `dotenv` from fastlane/ via Gemfile.
#
# Firebase Console → Project settings (gear) → Your apps → iOS → App ID (format: 1:PROJECT_NUMBER:ios:HASH)

FIREBASE_APP_ID=1:YOUR_PROJECT_NUMBER:ios:YOUR_APP_HASH

# Optional: duplicate here if you use a root-level tool that loads this file — **do not commit real values**.
# IPA_PATH=/absolute/path/to/FinalEvolutionLab-Firebase.ipa
# FIREBASE_TESTER_GROUPS=internal-testers
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
