# ============================================================================
# Final Evolution Lab — Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.template .env
#
# NEVER commit .env to version control!
# ============================================================================

# ── AI Service API Keys ─────────────────────────────────────────────────────
DEEPMOTION_CLIENT_ID=
DEEPMOTION_CLIENT_SECRET=
MESHY_API_KEY=
LUMA_API_KEY=

# ── AWS Configuration (for GPU deployment) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_KEY_NAME=fel-gpu-key
AWS_SECURITY_GROUP=fel-gpu-sg
AWS_SUBNET_ID=

# ── GitHub (for UE5 source access) ──────────────────────────────────────────
# Required: GitHub account must be linked to Epic Games account
# Create PAT at: https://github.com/settings/tokens
GITHUB_PAT=

# ── Streaming Infrastructure ────────────────────────────────────────────────
SIGNALLING_URL=http://localhost:8888
STREAMING_SERVER_URL=wss://stream.finalevolutiongroup.com
TURN_SERVER_URL=turn:turn.finalevolutiongroup.com:3478

# ── Build Configuration ─────────────────────────────────────────────────────
# UE5_ROOT=/path/to/UnrealEngine
# FEL_PROJECT=/path/to/FinalEvolutionLab.uproject

# ── Notification (optional) ─────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=
# EMAIL_NOTIFY=your@email.com
