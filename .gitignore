# React Native / Expo artifacts (should not exist in Swift projects)
#
# These were blanket rules from stripping React Native out. Three of them —
# package.json, package-lock.json and tsconfig.json — would silently swallow
# the Next.js app's manifest and TypeScript config the moment the web app is
# synced into this repo, producing a checkout that cannot be installed or
# type-checked, with no error to explain why. Scoped to the Expo leftovers
# only.
node_modules/
.expo/
.bundle/
android/
ios/
babel.config.js
metro.config.js
/app.json

# Xcode
FinalEvolutionLab/GoogleService-Info.plist
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# IDE and editors
.idea/
.vscode/

# Yarn / JS (if present)
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js (if present)
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Testing / coverage
/coverage

# Production builds
/build
dist/
dist

# Local-only Superapp pointers (copy from superapp-reference/LOCAL_AND_SECRET_POINTER.template.md)
superapp-reference/LOCAL_AND_SECRET_POINTER.md

# Environment and credentials
.env
.env.*
!.env.example
!**/.env.example
*.env
*token.json*
*credentials.json*
credentials.json
*.pem
*.key
.credentials

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS / system
.DS_Store
*.swp
*~

