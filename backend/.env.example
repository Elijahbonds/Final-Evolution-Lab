MONGO_URL=mongodb://localhost:27017
DB_NAME=final_evolution_lab
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000

# Optional AI provider key. When omitted, AI endpoints return safe fallback guidance.
EMERGENT_LLM_KEY=

# Optional PayPal checkout. When omitted, payment endpoints return 503 with a config message.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Sovereign / UE bridge defaults
EMERGENT_GAME_WS_URL=wss://finalevolutiongroup.com/ws/sovereign
SOVEREIGN_KEEPALIVE_INTERVAL=0.5
SOVEREIGN_FOCUS_LOCK=true
SOVEREIGN_ENCRYPTION=AES-256-GCM
