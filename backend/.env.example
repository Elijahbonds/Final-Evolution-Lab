MONGO_URL=mongodb://localhost:27017
DB_NAME=final_evolution_lab
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000

# Optional provider integrations. Leave blank for local development; affected
# endpoints return a clear degraded response instead of crashing startup.
EMERGENT_LLM_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Sovereign Hub / Pixel Streaming
EMERGENT_GAME_WS_URL=wss://finalevolutiongroup.com/ws/sovereign
E3DS_API_KEY=
E3DS_STREAM_URL=
E3DS_IFRAME_URL=
SOVEREIGN_KEEPALIVE_INTERVAL=0.5
SOVEREIGN_FOCUS_LOCK=true
SOVEREIGN_ENCRYPTION=AES-256-GCM
