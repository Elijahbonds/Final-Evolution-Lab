# MongoDB connection. These defaults match backend/core.py for local development.
MONGO_URL=mongodb://localhost:27017
DB_NAME=final_evolution_lab
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000

# Optional AI provider key used by AI Coach and Bio-Fuel vision scanning.
# Without this key, those endpoints return fallback/offline responses.
EMERGENT_LLM_KEY=

# Optional PayPal sandbox credentials for creator-card checkout.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
