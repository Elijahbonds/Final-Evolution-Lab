# Copy to fastlane/.env and fill in (fastlane/.env is gitignored if you use dotenv;
# otherwise export these in your shell — see fastlane/README.md)

# Optional: CI compile-only xcodebuild without committing GoogleService-Info.plist —
# enables build phase to copy GoogleService-Info.example.plist → GoogleService-Info.plist.
# Do NOT ship with placeholder; replace plist with your Firebase download before TestFlight.
# ALLOW_GOOGLE_SERVICE_PLACEHOLDER=1

# Firebase console → Project settings → Your apps → iOS app → App ID
# Must match the iOS app whose bundle ID matches Xcode (e.g. com.finalevolutionlab.app).
FIREBASE_APP_ID=1:YOUR_PROJECT_NUMBER:ios:YOUR_APP_HASH

# Firebase: use the **ad-hoc** IPA (not App Store export):
#   fel_ue5_ios_shipping_package.sh ... --export-ipa-firebase
#   → .../Binaries/IOS/FinalEvolutionLab-Firebase.ipa
# App Store / TestFlight: use FinalEvolutionLab.ipa from --export-ipa (app-store method)
IPA_PATH=/absolute/path/to/FinalEvolutionLab-Firebase.ipa

# Comma-separated tester group aliases (create groups in Firebase App Distribution)
FIREBASE_TESTER_GROUPS=internal-testers

# Optional: comma-separated tester emails (invitations) if not using groups only
# FIREBASE_TESTERS=you@example.com,qa@example.com

FIREBASE_RELEASE_NOTES=Build from main — internal QA

# Path to service account JSON (Firebase App Distribution API / IAM)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json

# --- TestFlight (`fastlane beta_testflight` or `fastlane testflight`) ---
# Requires a signed **App Store** IPA (not ad-hoc). Same IPA_PATH as above or override.
# SKIP_WAITING_TF_BUILD=false  # set to wait for App Store Connect processing (CI only)
# FASTLANE_USER=you@apple.id  # or use App Store Connect API key (see fastlane docs)
# APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXX.p8
# APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
