# Backend API. Local development defaults to http://localhost:8000 when unset.
REACT_APP_BACKEND_URL=http://localhost:8000

# Firebase web app config. Required for Google sign-in in non-preview builds.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=final-evolution-lab.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=final-evolution-lab
REACT_APP_FIREBASE_STORAGE_BUCKET=final-evolution-lab.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# PayPal client id. The app falls back to the PayPal SDK test id for local preview only.
REACT_APP_PAYPAL_CLIENT_ID=

# Optional developer-only BioDigital controls.
REACT_APP_ENABLE_BIO_DIGITAL_DEV_TOOLS=false
