REACT_APP_BACKEND_URL=http://localhost:8000

# Firebase web config for local development. Use real project values in deployed
# environments; do not commit secrets or private service account credentials.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Optional commerce/dev feature toggles.
REACT_APP_PAYPAL_CLIENT_ID=
REACT_APP_ENABLE_BIO_DIGITAL_DEV_TOOLS=false
