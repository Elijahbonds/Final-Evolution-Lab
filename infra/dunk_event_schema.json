{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://finalevolutiongroup.com/schemas/dunk_event/v1.json",
  "title": "DunkEvent",
  "description": "Wire format for a server-scored dunk attempt in the FEL Basketball Dunk Contest. Every field is required for a valid, auditable replay.",
  "type": "object",
  "required": ["match_id", "seed", "player_inputs", "judge_offsets", "result"],
  "additionalProperties": false,
  "properties": {
    "match_id": {
      "type": "string",
      "minLength": 8,
      "description": "Unique match identifier, issued by POST /api/matches/create"
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "description": "64-bit non-repeating integer generated by os.urandom at match creation. Drives all judge offsets deterministically."
    },
    "player_inputs": {
      "type": "object",
      "required": ["launch_angle", "trick_sequence_hash", "landing_precision"],
      "additionalProperties": false,
      "description": "Raw inputs captured from the iOS client during the dunk attempt.",
      "properties": {
        "launch_angle": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "trick_sequence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        },
        "landing_precision": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "style_key": {
          "type": "string",
          "enum": ["360_windmill", "between_the_legs", "reverse_jam", "tomahawk", "alley_oop", "finger_roll", "power_slam"]
        },
        "attempt_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "judge_offsets": {
      "type": "array",
      "items": {"type": "integer", "minimum": -5, "maximum": 5},
      "minItems": 3,
      "maxItems": 3
    },
    "result": {
      "type": "object",
      "required": ["j1", "j2", "j3", "total", "message", "is_perfect"],
      "additionalProperties": false,
      "properties": {
        "j1": {"type": "integer", "minimum": 3, "maximum": 10},
        "j2": {"type": "integer", "minimum": 3, "maximum": 10},
        "j3": {"type": "integer", "minimum": 3, "maximum": 10},
        "total": {"type": "integer", "minimum": 9, "maximum": 30},
        "message": {"type": "string", "enum": ["PERFECT SCORE", "OUTSTANDING", "SOLID DUNK", "NEEDS WORK"]},
        "is_perfect": {"type": "boolean"}
      }
    },
    "verification_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "const": "dunk_result"
    }
  },
  "examples": [
    {
      "match_id": "3fa85f64-5717",
      "seed": 7823640192837465,
      "player_inputs": {
        "launch_angle": 0.87,
        "trick_sequence_hash": "a1b2c3d4",
        "landing_precision": 0.91,
        "style_key": "360_windmill",
        "attempt_number": 1
      },
      "judge_offsets": [2, -1, 4],
      "result": {
        "j1": 10,
        "j2": 8,
        "j3": 10,
        "total": 28,
        "message": "OUTSTANDING",
        "is_perfect": false
      },
      "event_type": "dunk_result",
      "timestamp": "2026-07-01T18:00:00Z"
    },
    {
      "match_id": "3fa85f64-5717",
      "seed": 7823640192837465,
      "player_inputs": {
        "launch_angle": 1.0,
        "trick_sequence_hash": "a1b2c3d4",
        "landing_precision": 1.0,
        "style_key": "360_windmill",
        "attempt_number": 2
      },
      "judge_offsets": [5, 5, 5],
      "result": {
        "j1": 10,
        "j2": 10,
        "j3": 10,
        "total": 30,
        "message": "PERFECT SCORE",
        "is_perfect": true
      },
      "event_type": "dunk_result",
      "timestamp": "2026-07-01T18:01:30Z"
    }
  ]
}
