  "speed_design_notes": {
    "prq_to_speed_mapping": "movementSpeedScale = 0.6 + prqNorm * 2.2 (ArcadePhysics::fromPRQ)",
    "sora_tier": { "prq_range": [0, 55], "speed_scale_range": [0.6, 1.8], "feel": "KH1 Sora base movement" },
    "primed_tier": { "prq_range": [56, 79], "speed_scale_range": [1.8, 2.3], "feel": "Fast — arcade platformer" },
    "sonic_tier": { "prq_range": [80, 100], "speed_scale_range": [2.3, 2.8], "feel": "Near-Sonic SA2 speed" },
    "sprint_stub_prq": 75,
    "sprint_stub_speed_scale": 2.25,
    "flight_speed": "flightSpeedScale = 0.8 + prqNorm * 1.2 (glide 0.8→2.0)"
  },

  "ios_performance_notes": {
