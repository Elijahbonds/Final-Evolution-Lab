{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://finalevolutiongroup.com/schemas/fel_event/v1.json",
  "title": "FELEvent",
  "description": "Universal wire format for all server-scored FEL match events.",
  "type": "object",
  "required": ["header", "sequence", "outcome"],
  "additionalProperties": false,
  "properties": {
    "header": {
      "type": "object",
      "required": ["match_id", "mode_id", "server_seed", "version"],
      "additionalProperties": false,
      "properties": {
        "match_id": {"type": "string", "minLength": 8},
        "mode_id": {
          "type": "string",
          "enum": ["basketball_dunk", "basketball_h2h", "basketball_3v3", "gymnastics", "surfing", "skateboarding", "karate", "tennis", "golf", "baseball", "football", "soccer", "brain_brawl", "who_scene_it"]
        },
        "server_seed": {"type": "integer", "minimum": 1},
        "version": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
        "created_at": {"type": "string", "format": "date-time"},
        "player_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 6}
      }
    },
    "sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "actor_id", "action_type", "payload"],
        "additionalProperties": false,
        "properties": {
          "frame": {"type": "integer", "minimum": 0},
          "actor_id": {"type": "string"},
          "action_type": {
            "type": "string",
            "enum": ["judged_score", "precision_hit", "score_event", "answer_submitted", "match_start", "match_end", "timeout"]
          },
          "payload": {"type": "object", "minProperties": 1}
        }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["score"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["integer", "number"]}},
        "winner_id": {"type": ["string", "null"]},
        "judge_offsets": {
          "type": "array",
          "items": {"type": "integer", "minimum": -5, "maximum": 5},
          "minItems": 3,
          "maxItems": 3
        },
        "verification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "metadata": {"type": "object", "additionalProperties": true}
      }
    }
  },
  "examples": [
    {
      "header": {
        "match_id": "3fa85f64-5717",
        "mode_id": "basketball_dunk",
        "server_seed": 7823640192837465,
        "version": "1.0",
        "created_at": "2026-07-01T18:00:00Z",
        "player_ids": ["user_abc123"]
      },
      "sequence": [
        {"frame": 0, "actor_id": "user_abc123", "action_type": "match_start", "payload": {"judge_offsets": [2, -1, 4]}},
        {"frame": 4200, "actor_id": "user_abc123", "action_type": "judged_score", "payload": {"j1": 10, "j2": 8, "j3": 10, "total": 28, "message": "OUTSTANDING", "is_perfect": false, "mode_id": "basketball_dunk"}},
        {"frame": 9600, "actor_id": "user_abc123", "action_type": "match_end", "payload": {"reason": "all_attempts_complete"}}
      ],
      "outcome": {
        "score": {"user_abc123": 28},
        "winner_id": "user_abc123",
        "judge_offsets": [2, -1, 4],
        "verification_hash": "a3f8b2c1d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1",
        "duration_ms": 9600,
        "metadata": {"perfect_count": 0, "top_moment": {"total": 28, "message": "OUTSTANDING"}}
      }
    },
    {
      "header": {
        "match_id": "9ab12c34-8901",
        "mode_id": "brain_brawl",
        "server_seed": 3141592653589793,
        "version": "1.0",
        "created_at": "2026-07-01T19:00:00Z",
        "player_ids": ["user_x", "user_y"]
      },
      "sequence": [
        {"frame": 0, "actor_id": "user_x", "action_type": "match_start", "payload": {"mode_id": "brain_brawl"}},
        {"frame": 2300, "actor_id": "user_x", "action_type": "answer_submitted", "payload": {"final_score": 135, "breakdown": {"correct": true, "speed_bonus": 35, "response_ms": 2300}}},
        {"frame": 3100, "actor_id": "user_y", "action_type": "answer_submitted", "payload": {"final_score": 118, "breakdown": {"correct": true, "speed_bonus": 18, "response_ms": 3100}}}
      ],
      "outcome": {
        "score": {"user_x": 135, "user_y": 118},
        "winner_id": "user_x",
        "verification_hash": "b4c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9",
        "duration_ms": 10000,
        "metadata": {"rounds": 1}
      }
    }
  ]
}
