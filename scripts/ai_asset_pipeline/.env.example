# ============================================================
# AI Asset Pipeline — API Keys
# ============================================================
# Copy this file to .env in the repo root (gitignored).
# Never commit real API keys.

# --- DeepMotion Animate 3D ---
# Obtain from: https://www.deepmotion.com/animate-3d-api
DEEPMOTION_CLIENT_ID=
DEEPMOTION_CLIENT_SECRET=
# DEEPMOTION_API_SERVER_URL=https://service.deepmotion.com

# --- Meshy AI ---
# Obtain from: https://www.meshy.ai/api (Settings > API Keys)
MESHY_API_KEY=

# --- Luma AI (Dream Machine) ---
# Obtain from: https://lumalabs.ai/dream-machine/api
LUMA_API_KEY=
