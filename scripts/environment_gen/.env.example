# Generative Environment Pipeline - API Keys
# Copy to .env in project root and add your keys

# Stability AI (Stable Video Diffusion / Stable Diffusion)
STABILITY_API_KEY=your_stability_api_key_here

# Runway (Gen-3 Alpha)
RUNWAY_API_KEY=your_runway_api_key_here

# Luma AI (Dream Machine / Ray2)
LUMA_API_KEY=your_luma_api_key_here

# NVIDIA Gaia (future - pending public API release)
GAIA_API_KEY=your_gaia_api_key_here
