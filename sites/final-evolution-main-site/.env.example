# Client (Vite) — safe to expose
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# PayPal JS SDK (Dashboard → Apps & credentials). Sandbox: use `sb` or your sandbox client id.
VITE_PAYPAL_CLIENT_ID=sb

# Optional: looping Spiral Line hero video
# VITE_HERO_VIDEO_URL=https://your-cdn/spiral-line-loop.mp4

# Supabase Edge `paypal-verify` requires (set in Supabase project secrets, not here):
# PAYPAL_CLIENT_ID, PAYPAL_SECRET, PAYPAL_ENV=sandbox|live
# SUPABASE_ANON_KEY (for JWT validation inside the function)
