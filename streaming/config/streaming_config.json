{
  "version": "1.0.0",
  "project": "FinalEvolutionLab",
  "description": "Pixel Streaming configuration for 16 FEL game modes",
  "pixelStreaming": {
    "signallingServerUrl": "ws://localhost:8888",
    "streamerPort": 8889,
    "playerPort": 8888,
    "resolution": {
      "width": 1920,
      "height": 1080
    },
    "framerate": 60,
    "bitrate": {
      "min": 5000000,
      "max": 20000000,
      "start": 10000000
    },
    "webRTC": {
      "iceServers": [
        {
          "urls": ["stun:stun.l.google.com:19302"]
        },
        {
          "urls": ["turn:localhost:3478"],
          "username": "fel",
          "credential": "fel_streaming_2026"
        }
      ],
      "degradationPreference": "maintain-framerate"
    }
  },
  "dataChannel": {
    "enabled": true,
    "ordered": true,
    "maxRetransmits": 3,
    "protocol": "fel-arena-v1",
    "commands": [
      "launch_mode",
      "exit_mode",
      "get_modes",
      "exercise_demo",
      "get_status",
      "set_prq",
      "toggle_hud"
    ]
  },
